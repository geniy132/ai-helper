# ========================================================
# Конфигурация AI-помощника подготовки карточек товаров
# ========================================================

# Выбор LLM-провайдера по умолчанию: "mock", "google", "openai"
LLM_PROVIDER=mock

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (или совместимый эндпоинт Ollama, Groq, vLLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Настройки сервера
HOST=127.0.0.1
PORT=8000
DEBUG=false
