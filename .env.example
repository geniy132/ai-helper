# ========================================================
# Конфигурация AI-помощника подготовки карточек товаров
# Выбранная модель: Ollama (Qwen)
# ========================================================

# Выбранный провайдер: "ollama" (основной) или "mock" (офлайн-тесты)
LLM_PROVIDER=ollama

# Локальная Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Настройки веб-сервера
HOST=127.0.0.1
PORT=8000
DEBUG=false
